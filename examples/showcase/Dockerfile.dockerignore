# Build only the framework modules and sample from the repository-root context
**
!go.mod
!go.sum
!gogo.go
!core/
!core/**
!internal/
!internal/**
!admin/
!admin/**
!async/
!async/**
!connectors/
!connectors/**
!examples/
!examples/showcase/
!examples/showcase/**

# Private configuration and credentials never enter the build context
**/.env
**/.env.*
!examples/showcase/.env.example
**/*.pem
**/*.key

# Host build output, runtime data and editor state
**/bin
**/var
**/coverage
**/*.test
**/coverage.out
**/.DS_Store
**/.idea
**/.vscode
**/node_modules
**/go.work
**/go.work.sum
