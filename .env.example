# Application
GOGO_ENV=development
GOGO_DEBUG=false

# Security
GOGO_SECRET_KEY=
GOGO_SECRET_KEY_FALLBACKS=
GOGO_ALLOWED_HOSTS=localhost,127.0.0.1
GOGO_TRUSTED_PROXIES=

# HTTP
GOGO_HTTP_ADDR=127.0.0.1:8000
GOGO_HTTP_READ_HEADER_TIMEOUT=5s
GOGO_HTTP_IDLE_TIMEOUT=60s
GOGO_MAX_BODY_BYTES=1048576
GOGO_MAX_UPLOAD_BYTES=10485760

# Database
GOGO_DATABASE_URL=
GOGO_DB_MAX_OPEN=20
GOGO_DB_MAX_IDLE=5
GOGO_DB_MAX_LIFETIME=30m
GOGO_DB_QUERY_TIMEOUT=5s

# Redis
GOGO_REDIS_URL=
GOGO_REDIS_NAMESPACE=
GOGO_REDIS_OPERATION_TIMEOUT=2s

# Sessions
GOGO_SESSION_BACKEND=postgres
GOGO_SESSION_TTL=336h
GOGO_SESSION_COOKIE_NAME=gogo_session

# Authentication
GOGO_PASSWORD_RESET_TTL=1h
GOGO_AUTH_TOKEN_TTL=24h
GOGO_RESET_DELIVERY_KEY_REF=

# Cache
GOGO_CACHE_TTL=300s
GOGO_CACHE_FAILURE_POLICY=bypass

# Mail
GOGO_SMTP_HOST=
GOGO_SMTP_PORT=587
GOGO_SMTP_USERNAME=
GOGO_SMTP_PASSWORD=
GOGO_MAIL_FROM=

# Files
GOGO_STORAGE_ROOT=
GOGO_STATIC_ROOT=
GOGO_MEDIA_PUBLIC=false

# Operations
GOGO_LOG_LEVEL=info
GOGO_SHUTDOWN_GRACE=30s
